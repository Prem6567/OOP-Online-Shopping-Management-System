import java.util.ArrayList;
import java.util.Scanner;

abstract class Product {
    private int productId;
    private String productName;
    private double price;
    private int stock;

    public Product(int productId, String productName,
                   double price, int stock) {
        this.productId = productId;
        this.productName = productName;
        this.price = price;
        this.stock = stock;
    }

    public int getProductId() {
        return productId;
    }

    public String getProductName() {
        return productName;
    }

    public double getPrice() {
        return price;
    }

    public int getStock() {
        return stock;
    }

    public boolean purchase(int quantity) {
        if (quantity <= 0 || quantity > stock) {
            return false;
        }

        stock -= quantity;
        return true;
    }

    public abstract String getCategory();

    public void displayProduct() {
        System.out.println("Product ID   : " + productId);
        System.out.println("Product Name : " + productName);
        System.out.printf("Price        : Rs. %.2f%n", price);
        System.out.println("Stock        : " + stock);
        System.out.println("Category     : " + getCategory());
        System.out.println("-----------------------------------");
    }
}

class Electronics extends Product {
    public Electronics(int id, String name,
                       double price, int stock) {
        super(id, name, price, stock);
    }

    @Override
    public String getCategory() {
        return "Electronics";
    }
}

class Clothing extends Product {
    public Clothing(int id, String name,
                    double price, int stock) {
        super(id, name, price, stock);
    }

    @Override
    public String getCategory() {
        return "Clothing";
    }
}

class ShoppingCart {
    private ArrayList<Product> products = new ArrayList<>();
    private ArrayList<Integer> quantities = new ArrayList<>();

    public void addToCart(Product product, int quantity) {
        if (quantity <= 0) {
            System.out.println("Quantity must be greater than zero.");
            return;
        }

        if (quantity > product.getStock()) {
            System.out.println("Insufficient stock available.");
            return;
        }

        int index = products.indexOf(product);

        int existingQuantity = (index == -1)
                ? 0 : quantities.get(index);

        if (existingQuantity + quantity > product.getStock()) {
            System.out.println("Requested quantity exceeds available stock.");
            return;
        }

        if (index != -1) {
            quantities.set(index, existingQuantity + quantity);
        } else {
            products.add(product);
            quantities.add(quantity);
        }

        System.out.println("Product added to cart successfully.");
    }

    public void displayCart() {
        if (products.isEmpty()) {
            System.out.println("Your shopping cart is empty.");
            return;
        }

        System.out.println("\n========== SHOPPING CART ==========");

        for (int i = 0; i < products.size(); i++) {
            Product product = products.get(i);
            int quantity = quantities.get(i);

            System.out.printf(
                "%s | Quantity: %d | Total: Rs. %.2f%n",
                product.getProductName(),
                quantity,
                product.getPrice() * quantity
            );
        }

        System.out.printf("Cart Total: Rs. %.2f%n", getTotal());
        System.out.println("===================================");
    }

    public double getTotal() {
        double total = 0;

        for (int i = 0; i < products.size(); i++) {
            total += products.get(i).getPrice()
                    * quantities.get(i);
        }

        return total;
    }

    public void checkout() {
        if (products.isEmpty()) {
            System.out.println("Your cart is empty. Add products first.");
            return;
        }

        // Validate all stock levels before processing the order.
        for (int i = 0; i < products.size(); i++) {
            if (quantities.get(i) > products.get(i).getStock()) {
                System.out.println(
                    "Checkout failed: insufficient stock for "
                    + products.get(i).getProductName()
                );
                return;
            }
        }

        double total = getTotal();

        // Reduce stock only after all products pass validation.
        for (int i = 0; i < products.size(); i++) {
            products.get(i).purchase(quantities.get(i));
        }

        System.out.println("\n========== ORDER CONFIRMED ==========");
        System.out.printf("Total Amount: Rs. %.2f%n", total);
        System.out.println("Thank you for shopping with us!");
        System.out.println("=====================================");

        products.clear();
        quantities.clear();
    }
}

public class Main {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        ArrayList<Product> inventory = new ArrayList<>();
        ShoppingCart cart = new ShoppingCart();

        inventory.add(new Electronics(101, "Laptop", 55000.00, 5));
        inventory.add(new Electronics(102, "Headphones", 1500.00, 10));
        inventory.add(new Clothing(103, "T-Shirt", 499.00, 20));
        inventory.add(new Clothing(104, "Jeans", 999.00, 15));

        int choice = 0;

        System.out.println("======================================");
        System.out.println("   ONLINE SHOPPING MANAGEMENT SYSTEM");
        System.out.println("======================================");

        while (choice != 5) {
            System.out.println("\n1. View All Products");
            System.out.println("2. Add Product to Cart");
            System.out.println("3. View Shopping Cart");
            System.out.println("4. Checkout");
            System.out.println("5. Exit");
            System.out.print("Enter your choice: ");

            if (!scanner.hasNextInt()) {
                System.out.println("Invalid input. Enter a number.");
                scanner.next();
                continue;
            }

            choice = scanner.nextInt();

            switch (choice) {
                case 1:
                    System.out.println("\n========== AVAILABLE PRODUCTS ==========");
                    for (Product product : inventory) {
                        product.displayProduct();
                    }
                    break;

                case 2:
                    System.out.print("Enter Product ID: ");

                    if (!scanner.hasNextInt()) {
                        System.out.println("Invalid product ID.");
                        scanner.next();
                        break;
                    }

                    int id = scanner.nextInt();
                    Product selectedProduct = null;

                    for (Product product : inventory) {
                        if (product.getProductId() == id) {
                            selectedProduct = product;
                            break;
                        }
                    }

                    if (selectedProduct == null) {
                        System.out.println("Product not found.");
                        break;
                    }

                    System.out.print("Enter Quantity: ");

                    if (!scanner.hasNextInt()) {
                        System.out.println("Invalid quantity.");
                        scanner.next();
                        break;
                    }

                    int quantity = scanner.nextInt();
                    cart.addToCart(selectedProduct, quantity);
                    break;

                case 3:
                    cart.displayCart();
                    break;

                case 4:
                    cart.checkout();
                    break;

                case 5:
                    System.out.println(
                        "Thank you for using our Online Shopping System!"
                    );
                    break;

                default:
                    System.out.println(
                        "Invalid choice. Please select 1 to 5."
                    );
            }
        }

        scanner.close();
    }
}